<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Puissance 4</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #111827;
            color: #e5e7eb;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: 100vh;
            margin: 0;
            padding-top: 40px;
        }

        h1 {
            margin-bottom: 10px;
        }

        .controls {
            margin-bottom: 20px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        select, button {
            background: #1f2937;
            color: #e5e7eb;
            border: 1px solid #4b5563;
            padding: 6px 10px;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover, select:hover {
            border-color: #9ca3af;
        }

        #status {
            margin-bottom: 15px;
            min-height: 20px;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(7, 70px);
            grid-template-rows: repeat(6, 70px);
            gap: 6px;
        }

        .cell {
            width: 70px;
            height: 70px;
            background: #111827;
            border-radius: 50%;
            border: 2px solid #4b5563;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
        }

        .cell:hover {
            background: #1f2937;
        }

        .p1 {
            background: #ef4444 !important;
        }

        .p2 {
            background: #3b82f6 !important;
        }

        .win {
            box-shadow: 0 0 12px 4px #fbbf24 !important;
            border-color: #fbbf24 !important;
        }
    </style>
</head>

<body>

    <h1>Puissance 4</h1>

    <div class="controls">
        <select id="mode">
            <option value="2p">2 Joueurs</option>
            <option value="easy">Bot Facile</option>
            <option value="medium">Bot Moyen</option>
            <option value="hard">Bot Difficile</option>
        </select>

        <button id="reset">Rejouer</button>
    </div>

    <div id="status">Joueur 1 commence.</div>

    <div class="board" id="board"></div>

    <script>
        const ROWS = 6;
        const COLS = 7;

        let board = [];
        let currentPlayer = 1;
        let gameOver = false;

        const boardDiv = document.getElementById("board");
        const statusDiv = document.getElementById("status");
        const modeSelect = document.getElementById("mode");

        function createBoard() {
            board = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
            boardDiv.innerHTML = "";
            gameOver = false;
            currentPlayer = 1;
            statusDiv.textContent = "Joueur 1 commence.";

            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS; c++) {
                    const cell = document.createElement("div");
                    cell.classList.add("cell");
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    cell.addEventListener("click", () => handleMove(c));
                    boardDiv.appendChild(cell);
                }
            }
        }

        function handleMove(col) {
            if (gameOver) return;

            const row = getAvailableRow(col);
            if (row === -1) return;

            placePiece(row, col, currentPlayer);

            if (checkWinAndHighlight(currentPlayer)) {
                statusDiv.textContent = `Joueur ${currentPlayer} a gagné !`;
                gameOver = true;
                return;
            }

            currentPlayer = currentPlayer === 1 ? 2 : 1;
            statusDiv.textContent = `Joueur ${currentPlayer} joue.`;

            if (currentPlayer === 2 && modeSelect.value !== "2p") {
                setTimeout(botMove, 300);
            }
        }

        function getAvailableRow(col) {
            for (let r = ROWS - 1; r >= 0; r--) {
                if (board[r][col] === 0) return r;
            }
            return -1;
        }

        function placePiece(row, col, player) {
            board[row][col] = player;
            const index = row * COLS + col;
            const cell = boardDiv.children[index];
            cell.classList.add(player === 1 ? "p1" : "p2");
        }

        function botMove() {
            if (gameOver) return;

            if (modeSelect.value === "easy") easyBot();
            else if (modeSelect.value === "medium") mediumBot();
            else hardBot();
        }

        function easyBot() {
            let col;
            do {
                col = Math.floor(Math.random() * COLS);
            } while (getAvailableRow(col) === -1);
            handleMove(col);
        }

        function mediumBot() {
            for (let c = 0; c < COLS; c++) {
                const r = getAvailableRow(c);
                if (r !== -1) {
                    board[r][c] = 2;
                    if (hasWin(2, board)) {
                        board[r][c] = 0;
                        return handleMove(c);
                    }
                    board[r][c] = 0;
                }
            }

            for (let c = 0; c < COLS; c++) {
                const r = getAvailableRow(c);
                if (r !== -1) {
                    board[r][c] = 1;
                    if (hasWin(1, board)) {
                        board[r][c] = 0;
                        return handleMove(c);
                    }
                    board[r][c] = 0;
                }
            }

            easyBot();
        }

        function hardBot() {
            let bestScore = -Infinity;
            let bestCol = 0;

            for (let c = 0; c < COLS; c++) {
                const r = getAvailableRow(c);
                if (r !== -1) {
                    board[r][c] = 2;
                    const score = minimax(5, false, -Infinity, Infinity);
                    board[r][c] = 0;

                    if (score > bestScore) {
                        bestScore = score;
                        bestCol = c;
                    }
                }
            }

            handleMove(bestCol);
        }

        function minimax(depth, isMax, alpha, beta) {
            if (hasWin(2, board)) return 1000 + depth;
            if (hasWin(1, board)) return -1000 - depth;
            if (depth === 0) return evaluateBoard(board);

            if (isMax) {
                let best = -Infinity;
                for (let c = 0; c < COLS; c++) {
                    const r = getAvailableRow(c);
                    if (r !== -1) {
                        board[r][c] = 2;
                        best = Math.max(best, minimax(depth - 1, false, alpha, beta));
                        board[r][c] = 0;
                        alpha = Math.max(alpha, best);
                        if (beta <= alpha) break;
                    }
                }
                return best;
            } else {
                let best = Infinity;
                for (let c = 0; c < COLS; c++) {
                    const r = getAvailableRow(c);
                    if (r !== -1) {
                        board[r][c] = 1;
                        best = Math.min(best, minimax(depth - 1, true, alpha, beta));
                        board[r][c] = 0;
                        beta = Math.min(beta, best);
                        if (beta <= alpha) break;
                    }
                }
                return best;
            }
        }

        function evaluateBoard(state) {
            return Math.random() * 20 - 10;
        }

        // --- LOGIQUE DE VICTOIRE ---

        function hasWin(player, state) {
            // Horizontal
            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS - 3; c++) {
                    if (
                        state[r][c] === player &&
                        state[r][c + 1] === player &&
                        state[r][c + 2] === player &&
                        state[r][c + 3] === player
                    ) return true;
                }
            }

            // Vertical
            for (let c = 0; c < COLS; c++) {
                for (let r = 0; r < ROWS - 3; r++) {
                    if (
                        state[r][c] === player &&
                        state[r + 1][c] === player &&
                        state[r + 2][c] === player &&
                        state[r + 3][c] === player
                    ) return true;
                }
            }

            // Diagonale ↘
            for (let r = 0; r < ROWS - 3; r++) {
                for (let c = 0; c < COLS - 3; c++) {
                    if (
                        state[r][c] === player &&
                        state[r + 1][c + 1] === player &&
                        state[r + 2][c + 2] === player &&
                        state[r + 3][c + 3] === player
                    ) return true;
                }
            }

            // Diagonale ↗
            for (let r = 3; r < ROWS; r++) {
                for (let c = 0; c < COLS - 3; c++) {
                    if (
                        state[r][c] === player &&
                        state[r - 1][c + 1] === player &&
                        state[r - 2][c + 2] === player &&
                        state[r - 3][c + 3] === player
                    ) return true;
                }
            }

            return false;
        }

        function checkWinAndHighlight(player) {
            // Horizontal
            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS - 3; c++) {
                    if (
                        board[r][c] === player &&
                        board[r][c + 1] === player &&
                        board[r][c + 2] === player &&
                        board[r][c + 3] === player
                    ) {
                        highlightWin([[r,c],[r,c+1],[r,c+2],[r,c+3]]);
                        return true;
                    }
                }
            }

            // Vertical
            for (let c = 0; c < COLS; c++) {
                for (let r = 0; r < ROWS - 3; r++) {
                    if (
                        board[r][c] === player &&
                        board[r + 1][c] === player &&
                        board[r + 2][c] === player &&
                        board[r + 3][c] === player
                    ) {
                        highlightWin([[r,c],[r+1,c],[r+2,c],[r+3,c]]);
                        return true;
                    }
                }
            }

            // Diagonale ↘
            for (let r = 0; r < ROWS - 3; r++) {
                for (let c = 0; c < COLS - 3; c++) {
                    if (
                        board[r][c] === player &&
                        board[r + 1][c + 1] === player &&
                        board[r + 2][c + 2] === player &&
                        board[r + 3][c + 3] === player
                    ) {
                        highlightWin([[r,c],[r+1,c+1],[r+2,c+2],[r+3,c+3]]);
                        return true;
                    }
                }
            }

            // Diagonale ↗
            for (let r = 3; r < ROWS; r++) {
                for (let c = 0; c < COLS - 3; c++) {
                    if (
                        board[r][c] === player &&
                        board[r - 1][c + 1] === player &&
                        board[r - 2][c + 2] === player &&
                        board[r - 3][c + 3] === player
                    ) {
                        highlightWin([[r,c],[r-1,c+1],[r-2,c+2],[r-3,c+3]]);
                        return true;
                    }
                }
            }

            return false;
        }

        function highlightWin(cells) {
            for (const [r, c] of cells) {
                const index = r * COLS + c;
                boardDiv.children[index].classList.add("win");
            }
        }

        document.getElementById("reset").addEventListener("click", createBoard);

        createBoard();
    </script>

</body>
</html>
